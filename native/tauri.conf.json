{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "deepseek-harness-desktop",
  "version": "0.2.1-rc.1",
  "identifier": "com.deepseek.dsh-desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek Harness Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:* ws://127.0.0.1:* ipc:; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "shell": {},
    "deep-link": {
      "desktop": {
        "schemes": [
          "dsh"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/dsh-host"
    ],
    "resources": {
      "../resources/app": "dsh-host/app",
      "../scripts/fetch-claude.mjs": "fetch-claude.mjs",
      "../scripts/fetch-codex.mjs": "fetch-codex.mjs"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
