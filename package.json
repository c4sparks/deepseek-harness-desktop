{
  "name": "deepseek-harness-desktop",
  "description": "DeepSeek Harness desktop shell: a Tauri app embedding the dsh host as a Node sidecar. App package producing installers; source published for traceability.",
  "version": "0.2.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "src",
    "native",
    "scripts"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "cd native && tauri dev",
    "build": "node scripts/package-sidecar.mjs && npm run build:bundle",
    "build:bundle": "cd native && tauri build",
    "build:sidecar": "node scripts/package-sidecar.mjs",
    "build:local": "node scripts/build-local.mjs",
    "quick:release": "node scripts/quick-release.mjs",
    "build:closure": "node scripts/build-closure.mjs",
    "bump:version": "node scripts/bump-version.mjs",
    "sync:list": "node scripts/sync-deps.mjs --list",
    "sync:manifest": "node scripts/sync-deps.mjs --refresh-manifest",
    "gen:icon": "tauri icon assets/app-icon.png",
    "tauri": "tauri"
  },
  "dependencies": {
    "deepseek-harness": "file:./deepseek-harness"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
